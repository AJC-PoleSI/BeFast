# Encryption master key for AES-256-GCM
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your_32_byte_hex_string_here

# Supabase
#
# ⚠️ SÉPARER DEV ET PROD — TRÈS IMPORTANT POUR LA SÉCURITÉ ⚠️
#
# Il doit exister DEUX projets Supabase distincts :
#   - "BeFast-dev"  : base de développement, utilisée en localhost (ce fichier).
#   - "BeFast-prod" : base de production, dont les clés ne vivent QUE dans les
#                     variables d'environnement Vercel (jamais dans un fichier).
#
# Pourquoi : localhost et Vercel tapent la base désignée par NEXT_PUBLIC_SUPABASE_URL.
# Si ce fichier pointe vers la PROD, n'importe quel dev qui lance l'app en local
# (ou qui copie la clé ci-dessous) écrit directement dans la base de production.
#
# SUPABASE_SERVICE_ROLE_KEY = clé maître ADMIN. Elle IGNORE la RLS, les triggers,
# toutes les permissions. Quiconque la détient est tout-puissant sur la base.
#   - Ne la partage JAMAIS, ne la commit JAMAIS (ce fichier .env.local est gitignoré).
#   - En cas de fuite : Supabase Dashboard → Settings → API → rotation de la clé,
#     puis remets la nouvelle clé UNIQUEMENT dans les variables Vercel.
#   - Aucune NEXT_PUBLIC_ devant : sinon elle partirait dans le bundle navigateur.
#
# La clé ANON est publique par conception (présente dans le bundle). La sécurité
# des membres connectés repose donc entièrement sur la RLS côté base.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url          # En local : URL de la base de DEV
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key         # clé publique (anon) de la base de DEV
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key     # service_role de la base de DEV (jamais celle de prod)

# Canonical site URL — used to build absolute links in emails
# (email verification, password reset). No trailing slash.
# Dev: http://localhost:3000  /  Prod: https://be-fast-beta.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Email Service (support reports, notifications, email verification)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
# Verified sender address (e.g. "BeFast <noreply@yourdomain.com>")
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Scaleway Object Storage (optional, for file uploads)
NEXT_PUBLIC_SCALEWAY_REGION=fr-par
SCALEWAY_ACCESS_KEY=your_access_key
SCALEWAY_SECRET_KEY=your_secret_key
SCALEWAY_BUCKET_NAME=your_bucket_name

# LiveConsent — signature électronique (https://liveconsent.readme.io)
# L'intégration est désactivée proprement si ces variables sont absentes.
LIVECONSENT_USERNAME=your_liveconsent_username
LIVECONSENT_DEVELOPER_KEY=your_developer_key
LIVECONSENT_SECRET_KEY=your_secret_key
