# Encryption master key for AES-256-GCM
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your_32_byte_hex_string_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend Email Service (for support reports and notifications)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Scaleway Object Storage (optional, for file uploads)
NEXT_PUBLIC_SCALEWAY_REGION=fr-par
SCALEWAY_ACCESS_KEY=your_access_key
SCALEWAY_SECRET_KEY=your_secret_key
SCALEWAY_BUCKET_NAME=your_bucket_name
